
CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    Not(in=sel , out=c);
    And(a=a , b=c , out=w1);    //sel 
    And(a=b , b=sel , out=w2);   //sel a
    Or(a=w1 , b=w2 , out=out);
   
}



//4 way
CHIP Mux4Way {
    IN a, b, c, d, sel[2];
    OUT out;

    PARTS:
    // First stage selects between (a, b) and (c, d) using sel[0]
    Mux(a=a, b=b, sel=sel[0], out=muxAB);
    Mux(a=c, b=d, sel=sel[0], out=muxCD);

    // Second stage selects between the two intermediate results using sel[1]
    Mux(a=muxAB, b=muxCD, sel=sel[1], out=out);
}